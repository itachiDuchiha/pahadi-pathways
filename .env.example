# Resend API key used to send transactional emails
RESEND_API_KEY=

# Verified sender address for outgoing enquiry emails
RESEND_FROM_EMAIL=

# Cloudflare Turnstile keys for the enquiry forms (https://dash.cloudflare.com/?to=/:account/turnstile)
# The CAPTCHA is on only when both are set; the site key is inlined at build time, so rebuild after changing it
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Fallback recipient for enquiry emails when no recipients are set in the admin's notification settings
TRIP_ENQUIRY_EMAIL=

# Public base URL of the deployed site
# Local development must set this to the dev origin (e.g. http://localhost:3000) for the admin login to stick
NEXT_PUBLIC_SITE_URL=https://thehimalayancompass.in

# Payload CMS signing secret, at least 32 random characters (openssl rand -hex 32)
PAYLOAD_SECRET=

# Database adapter: sqlite (default) or postgres
DATABASE_ADAPTER=sqlite

# Database connection: file:./data/cms.db for sqlite, postgres://... for postgres
DATABASE_URL=file:./data/cms.db

# Directory where uploaded media files are stored (outside public/)
MEDIA_DIR=media

# Optional: where uploads are streamed while processed (default: thc-uploads in the OS temp dir)
# UPLOAD_TEMP_DIR=

# Set by scripts/deploy.sh to build into .next-build before swapping it into .next; leave unset otherwise
# NEXT_DIST_DIR=.next

# First admin account, created on startup only when there are no users
PAYLOAD_ADMIN_EMAIL=

# Password for the first admin account, at least 12 characters
PAYLOAD_ADMIN_PASSWORD=

# Command scripts/deploy.sh runs to restart the server; empty means "systemctl --user restart thc"
# Quote it when it contains spaces, e.g. APP_RESTART_CMD="pm2 reload thc"
APP_RESTART_CMD=
