{
  "name": "the-himalayan-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "images:optimize": "node scripts/optimize-images.mjs",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "cms:seed": "tsx scripts/cms-seed.ts",
    "cms:prune-enquiries": "tsx scripts/cms-prune-enquiries.ts",
    "cms:set-password": "tsx scripts/cms-set-password.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.0",
    "@payloadcms/db-sqlite": "3.92.0",
    "@payloadcms/next": "3.92.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.24.0",
    "next": "^16.4.2",
    "payload": "3.92.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "resend": "^6.33.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "sass": "1.106.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
